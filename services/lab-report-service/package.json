{
  "name": "lab-report-service",
  "version": "1.0.0",
  "description": "Service for medical data extraction using Node.js and Python.",
  "main": "src/app.ts",
  "scripts": {
    "start": "node dist/app.js",
    "start:dev": "ts-node src/app.ts",
    "build": "tsc",
    "dev": "npm run dev:setup && ts-node-dev src/app.ts",
    "dev:setup": "cd ../../packages/logger && npm run build && cd ../kafka-client && npm run build && cd ../redis-client && npm run build",
    "test": "cross-env NODE_ENV=test SKIP_LISTEN=true jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test SKIP_LISTEN=true jest --watch",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/data-source.ts"
  },
  "dependencies": {
    "@medilink/kafka-client": "../../packages/kafka-client",
    "@medilink/logger": "../../packages/logger",
    "@medilink/redis-client": "../../packages/redis-client",
    "axios": "^0.21.1",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "multer": "^1.4.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^2.0.16",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^2.0.7",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typeorm-ts-node-commonjs": "^0.3.20"
  },
  "author": "MediLink",
  "license": "MIT"
}
