# All node_modules directories (including nested ones)
node_modules/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Development files
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
coverage/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Testing
.nyc_output
coverage/

# Documentation
*.md
!README.md

# Temporary files
*.tmp
*.temp

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Development tools
.eslintcache
.parcel-cache

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Exclude other services (we only need what we're building)
services/institution-service/
services/medical-history-service/
services/patient-record-service/

# Uploads directories (will be mounted as volume)
**/uploads/*
!**/uploads/.gitkeep
